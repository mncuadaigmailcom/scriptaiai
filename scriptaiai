-- ====================
-- XỬ LÝ ẨN / HIỆN MENU
-- ====================
local isMenuOpen = false

local function setMenuOpen(state)
	isMenuOpen = state
	mainFrame.Visible = state
	toggleButton.Text = state and "✕" or "⚙"
end

toggleButton.MouseButton1Click:Connect(function()
	setMenuOpen(not isMenuOpen)
end)

closeButton.MouseButton1Click:Connect(function()
	setMenuOpen(false)
end)

-- ====================
-- KÉO THẢ MENU (bằng thanh tiêu đề)
-- ====================
local dragging = false
local dragStartPos = nil
local frameStartPos = nil

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStartPos = input.Position
		frameStartPos = mainFrame.Position
	end
end)

titleBar.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStartPos
		mainFrame.Position = UDim2.new(
			frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X,
			frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y
		)
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

-- ====================
-- CHẠY CODE
-- ====================
runButton.MouseButton1Click:Connect(function()
	local code = codeBox.Text
	if code:match("^%s*$") then
		statusLabel.Text = "⚠️ Vui lòng nhập code!"
		return
	end

	-- Kiểm tra loadstring (chỉ có trong executor)
	if not loadstring then
		statusLabel.Text = "❌ Cần executor (loadstring không có)"
		return
	end

	local fn, syntaxErr = loadstring(code)
	if not fn then
		statusLabel.Text = "❌ Lỗi cú pháp: " .. tostring(syntaxErr)
		return
	end

	local success, result = pcall(fn)
	if success then
		statusLabel.Text = "✅ Đã chạy! (Xem Output)"
		print("✅ [Executor] Output:", result)
	else
		statusLabel.Text = "❌ Lỗi runtime: " .. tostring(result)
		warn("❌ [Executor] Runtime Error:", result)
	end
end)
