local menuVisible = false

local function setMenuVisible(state)
	menuVisible = state
	mainFrame.Visible = state
	toggleButton.Text = state and "✕" or "⚙"
end

toggleButton.MouseButton1Click:Connect(function()
	setMenuVisible(not menuVisible)
end)

closeButton.MouseButton1Click:Connect(function()
	setMenuVisible(false)
end)

-- ====================
-- KÉO THẢ MENU (đơn giản, dùng Mouse)
-- ====================
local UserInputService = game:GetService("UserInputService")
local dragging = false
local dragStartPos = nil
local frameStartPos = nil

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStartPos = input.Position
		frameStartPos = mainFrame.Position
	end
end)

titleBar.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStartPos
		mainFrame.Position = UDim2.new(
			frameStartPos.X.Scale,
			frameStartPos.X.Offset + delta.X,
			frameStartPos.Y.Scale,
			frameStartPos.Y.Offset + delta.Y
		)
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

-- ====================
-- CHẠY CODE (có kiểm tra loadstring)
-- ====================
runButton.MouseButton1Click:Connect(function()
	local code = codeBox.Text
	local name = nameBox.Text

	if #code == 0 then
		statusLabel.Text = "⚠️ Vui lòng nhập code!"
		return
	end

	-- In tên ra Output (nếu có)
	if #name > 0 then
		print("👤 Tên người dùng:", name)
	end

	-- Kiểm tra loadstring (chỉ có khi dùng executor)
	if not loadstring then
		statusLabel.Text = "❌ loadstring không hỗ trợ. Cần executor."
		warn("Executor required: loadstring is not available in normal Roblox environment.")
		return
	end

	local fn, syntaxErr = loadstring(code)
	if not fn then
		statusLabel.Text = "❌ Lỗi cú pháp: " .. tostring(syntaxErr)
		return
	end

	local success, runtimeResult = pcall(fn)
	if success then
		statusLabel.Text = "✅ Đã thực thi (xem Output)"
		print("✅ [Executor] Kết quả:", runtimeResult)
	else
		statusLabel.Text = "❌ Lỗi runtime: " .. tostring(runtimeResult)
		warn("❌ [Executor] Runtime Error:", runtimeResult)
	end
end)
