-- ==================== DIRECTIONAL NOCLIP ====================
local function enableDirectionalNoclip()
    if directionalNoclipConnection then directionalNoclipConnection:Disconnect() end
    directionalNoclipConnection = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local dir = Vector3.zero
            local speed = tonumber(P_SpeedBox.Text) or 100
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + hrp.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - hrp.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - hrp.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + hrp.CFrame.RightVector end
            if dir.Magnitude > 0 then
                hrp.CFrame = CFrame.new(hrp.Position + dir.Unit * speed * 0.016)
            end
        end
    end)
end

local function disableDirectionalNoclip()
    if directionalNoclipConnection then directionalNoclipConnection:Disconnect(); directionalNoclipConnection = nil end
    if not flyUpActive and not flyDownActive and not isFlying and not followPlayerActive then
        local char = LocalPlayer.Character
        if char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = (p.Name ~= "HumanoidRootPart") end
            end
        end
    end
end

DirectionalNoclipBtn.MouseButton1Click:Connect(function()
    directionalNoclipActive = not directionalNoclipActive
    DirectionalNoclipBtn.Text = directionalNoclipActive and "🔮 Xuyên Tường Thẳng: ON" or "🔮 Xuyên Tường Thẳng: OFF"
    DirectionalNoclipBtn.BackgroundColor3 = directionalNoclipActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(220, 225, 235)
    if directionalNoclipActive then enableDirectionalNoclip() else disableDirectionalNoclip() end
