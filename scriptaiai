-- ==================== FLY TO TARGET ====================
local function tweenFly(hrp, target, speed)
    if stopRequested then return false end
    local dist = (target.Position - hrp.Position).Magnitude
    local tween = TweenService:Create(hrp, TweenInfo.new(dist/speed, Enum.EasingStyle.Linear), {CFrame = target})
    tween:Play()
    local done = false
    local conn = tween.Completed:Connect(function() done = true end)
    repeat task.wait() until done or stopRequested
    if stopRequested then tween:Cancel() end
    conn:Disconnect()
    return done
end

function stopFly()
    stopRequested = true
    if currentTween then currentTween:Cancel() end
    isFlying = false
    stopFlyUp(); stopFlyDown()
    updateNoclipState()
    updatePlayerList(); updateSavedList(); updateWallList()
end

function startFly(mode, target)
    if isFlying then return end
    if followPlayerActive then stopFollow() end
    
    local getPos
    if mode == "Player" then
        selectedPlayer = target
        getPos = function() local p = getTargetPart(target); return p and p.Position end
    elseif mode == "Location" then
        selectedLocation = target
        getPos = function() return target.pos end
    elseif mode == "Wall" then
        selectedWall = target
        getPos = function() return target.part and target.part.Parent and target.part.Position + Vector3.new(0, target.part.Size.Y/2 + 2.5, 0) end
    end
    
    if not getPos or not getPos() then return end
    
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    isFlying = true; stopRequested = false
    updatePlayerList(); updateSavedList(); updateWallList()
    updateNoclipState()
    
    local oldGravity = workspace.Gravity
    workspace.Gravity = 0
    local height = tonumber(P_HeightBox.Text) or 150
    local speed = tonumber(P_SpeedBox.Text) or 100
    
    -- Fly up
    local ok = tweenFly(hrp, CFrame.new(hrp.Position + Vector3.new(0, height, 0)), speed)
    -- Fly horizontal
    if ok then
        local dest = getPos()
        if dest then
            ok = tweenFly(hrp, CFrame.new(Vector3.new(dest.X, hrp.Position.Y, dest.Z)), speed)
            -- Fly down
            if ok then
                dest = getPos()
                if dest then tweenFly(hrp, CFrame.new(dest), speed) end
            end
        end
    end
    
    workspace.Gravity = oldGravity
    isFlying = false
    updateNoclipState()
    updatePlayerList(); updateSavedList(); updateWallList()
end

