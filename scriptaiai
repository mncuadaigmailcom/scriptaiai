-- ESP Update Loop
RunService.RenderStepped:Connect(function()
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    -- Player ESP
    if espAllActive or espSingleActive then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local shouldTrack = espAllActive or (espSingleActive and selectedPlayer == plr)
                if shouldTrack then
                    createESP(plr)
                    local data = espStorage[plr]
                    if data then
                        local hrp = plr.Character.HumanoidRootPart
                        local head = plr.Character:FindFirstChild("Head") or hrp
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        data.Gui.Adornee = head
                        data.Gui.Parent = ScreenGui
                        local dist = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0
                        local hp = hum and math.floor(hum.Health) or 0
                        local maxHp = hum and math.floor(hum.MaxHealth) or 100
                        if isPlayerDead(plr) then
                            data.Label.TextColor3 = COLOR_DEAD
                            data.Label.Text = string.format("🔴 [%s]\n💀 ĐÃ CHẾT | %dm", plr.DisplayName, dist)
                        else
                            data.Label.TextColor3 = Color3.fromRGB(0, 255, 128)
                            data.Label.Text = string.format("👤 [%s]\n💚 %d/%d | %dm", plr.DisplayName, hp, maxHp, dist)
                        end
                    end
                else
                    removeESP(plr)
                end
            end
        end
    else
        removeAllESP()
    end
    
    -- Location ESP
    if locEspAllActive or locEspSingleActive then
        for _, item in ipairs(savedLocations) do
            local shouldTrack = locEspAllActive or (locEspSingleActive and selectedLocation == item)
            if shouldTrack then
                createLocESP(item)
                if locEspStorage[item] then
                    locEspStorage[item].Attachment.WorldPosition = item.pos
                    local dist = myHrp and math.floor((item.pos - myHrp.Position).Magnitude) or 0
                    locEspStorage[item].Label.Text = string.format("📍 [%s]\n📏 %dm", item.name, dist)
                end
            else
                removeLocESP(item)
            end
        end
    else
        removeAllLocESP()
    end
    
    -- Wall ESP
    if wallEspAllActive or wallEspSingleActive then
        for _, item in ipairs(spawnedWalls) do
            if item.part and item.part.Parent then
                local shouldTrack = wallEspAllActive or (wallEspSingleActive and selectedWall == item)
                if shouldTrack then
                    createWallESP(item)
                    if wallEspStorage[item] then
                        local dist = myHrp and math.floor((item.part.Position - myHrp.Position).Magnitude) or 0
                        wallEspStorage[item].Label.Text = string.format("🧱 [%s]\n📏 %dm", item.name, dist)
                    end
                else
                    removeWallESP(item)
                end
            end
        end
    else
        removeAllWallESP()
    end
end)

