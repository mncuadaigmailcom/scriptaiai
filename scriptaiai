-- ==================== RESIZE CORNERS ====================
local minSize, maxSize = Vector2.new(480, 280), Vector2.new(950, 650)
local activeCorner, cornerStartMouse, cornerStartSize, cornerStartPos = nil, nil, nil, nil

local corners = {
    {Name = "TL", Icon = "◤", Pos = UDim2.new(0, 0, 0, 0)},
    {Name = "TR", Icon = "◥", Pos = UDim2.new(1, -20, 0, 0)},
    {Name = "BL", Icon = "◣", Pos = UDim2.new(0, 0, 1, -20)},
    {Name = "BR", Icon = "◢", Pos = UDim2.new(1, -20, 1, -20)}
}

for _, c in ipairs(corners) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 18, 0, 18)
    btn.Position = c.Pos
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundTransparency = 0.5
    btn.Text = c.Icon
    btn.TextColor3 = TEXT_DARK
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12
    btn.ZIndex = 12
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)
    
    btn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1) and not activeCorner then
            activeCorner = c.Name
            cornerStartMouse = UserInputService:GetMouseLocation()
            cornerStartSize = MainFrame.AbsoluteSize
            cornerStartPos = MainFrame.AbsolutePosition
        end
    end)
end

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then activeCorner = nil end
end)

UserInputService.InputChanged:Connect(function(input)
    if activeCorner and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = UserInputService:GetMouseLocation() - cornerStartMouse
        local w, h = cornerStartSize.X, cornerStartSize.Y
        
        if activeCorner == "BR" then w, h = w + delta.X, h + delta.Y
        elseif activeCorner == "BL" then w, h = w - delta.X, h + delta.Y
        elseif activeCorner == "TR" then w, h = w + delta.X, h - delta.Y
        elseif activeCorner == "TL" then w, h = w - delta.X, h - delta.Y end
        
        w, h = math.clamp(w, minSize.X, maxSize.X), math.clamp(h, minSize.Y, maxSize.Y)
        local dx, dy = w - cornerStartSize.X, h - cornerStartSize.Y
        local x, y = cornerStartPos.X, cornerStartPos.Y
        
        if activeCorner == "BL" or activeCorner == "TL" then x = x - dx end
        if activeCorner == "TR" or activeCorner == "TL" then y = y - dy end
        
        MainFrame.Size = UDim2.new(0, w, 0, h)
        MainFrame.Position = UDim2.new(0, x, 0, y)
    end
end)

